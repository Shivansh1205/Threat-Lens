# Copy to .env and fill in real values. See CONTRIBUTING.md for details.

# --- Core app ---
ENV=development
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list of origins allowed to call this API from a browser
# (the frontend dev server, plus the 127.0.0.1 alias). No spaces needed
# around commas, but stray whitespace is tolerated either way.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Dev DB runs on 5433 because native Postgres often owns 5432. Change if yours differs.
DATABASE_URL=postgresql://postgres:devpass@localhost:5433/threatlens

# Connection pool size (steady-state connections kept open) and max overflow
# (extra connections allowed above pool_size under burst load). The default
# SQLAlchemy pool (5 + 10 overflow) can be saturated by bursty log ingestion
# (e.g. generate_logs.py --speed 100), causing QueuePool timeouts / 500s.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# --- Auth ---
JWT_SECRET=change-me
INGEST_API_KEY=replace-with-a-random-collector-key
ADMIN_API_KEY=replace-with-a-random-admin-key
IP_HASH_SECRET=replace-with-a-random-hash-secret
MAX_BATCH_SIZE=250
MAX_EVENT_AGE_HOURS=168
MAX_EVENT_FUTURE_SKEW_SECONDS=300
SOURCE_STALE_SECONDS=30
LOGIN_PATHS=/login

# --- LLM / explainability layer (Phase 5) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# --- Detection thresholds (Phase 3) ---
# Brute-force login detection (sliding window keyed by user_id):
BRUTE_FORCE_WINDOW_SECONDS=60
BRUTE_FORCE_MEDIUM_THRESHOLD=5
BRUTE_FORCE_HIGH_THRESHOLD=10
BRUTE_FORCE_CRITICAL_THRESHOLD=20

# Port-scan detection (sliding window keyed by source IP):
PORT_SCAN_WINDOW_SECONDS=3
PORT_SCAN_HIGH_THRESHOLD=15
PORT_SCAN_CRITICAL_THRESHOLD=50

# Unusual-IP detection:
UNUSUAL_IP_BOOTSTRAP_COUNT=3

# --- Nginx/web detectors ---
REQUEST_RATE_WINDOW_SECONDS=10
REQUEST_RATE_HIGH_THRESHOLD=30
REQUEST_RATE_CRITICAL_THRESHOLD=75
PATH_PROBE_WINDOW_SECONDS=60
PATH_PROBE_HIGH_THRESHOLD=8
PATH_PROBE_CRITICAL_THRESHOLD=20
SERVER_ERROR_WINDOW_SECONDS=60
SERVER_ERROR_HIGH_THRESHOLD=5
SERVER_ERROR_CRITICAL_THRESHOLD=15

# --- Behavior profiling (Phase 4) ---
# EMA smoothing factor, shared by every metric BehaviorProfiler tracks (login
# hour, login-hour variance, days-between-logins, session duration). Smaller
# = slower to adapt / more resistant to one-off noise.
EMA_ALPHA=0.05
